# =================================================================
# CampusIQ / CollegeBuddy — Production Environment Variables
# Copy this file to .env on the EC2 host and fill in actual secrets
# =================================================================

# Application Mode: 'production' or 'development'
ENVIRONMENT=production

# Database Configuration (PostgreSQL running in Docker network on EC2)
# Format: postgresql://<user>:<password>@postgres:5432/<dbname>
POSTGRES_USER=collegebuddy_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=collegebuddy_db
DATABASE_URL=postgresql://collegebuddy_user:your_strong_postgres_password_here@postgres:5432/collegebuddy_db

# Security: JWT secret key (Generate via: openssl rand -hex 32)
SECRET_KEY=your_64_char_hex_secret_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Cloud Media & File Storage (Cloudinary)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Frontend Domain for CORS (Cloudflare Pages URL or custom domain)
# Multiple origins can be comma-separated
FRONTEND_URL=https://your-app.pages.dev

# Production Caddy Reverse Proxy Domain
DOMAIN=api.yourdomain.com
